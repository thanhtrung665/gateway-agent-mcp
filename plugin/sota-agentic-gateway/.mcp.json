{
  "mcpServers": {
    "sota-agentic-gateway": {
      "command": "uv",
      "args": ["run", "--quiet", "--script", "${CLAUDE_PLUGIN_ROOT}/server/agw_mcp.py"],
      "env": {
        "AGW_WORKDIR": "${user_config.workdir}",
        "AGW_IMAP_HOST": "${user_config.imap_host}",
        "AGW_IMAP_USER": "${user_config.imap_user}",
        "AGW_IMAP_PASSWORD": "${user_config.imap_password}",
        "AGW_SMTP_HOST": "${user_config.smtp_host}",
        "AGW_SEND_MODE": "${user_config.send_mode}",
        "AGW_API_URL": "${user_config.api_url}",
        "AGW_API_KEY": "${user_config.api_key}"
      }
    }
  }
}
